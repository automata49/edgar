[Unit]
Description=Invest Flow web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/edgar
EnvironmentFile=-/home/ubuntu/edgar/.env
Environment=INVEST_FLOW_PORT=8081
ExecStart=/usr/bin/python3 /home/ubuntu/edgar/InvestFlowWeb/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
